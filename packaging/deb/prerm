#!/bin/sh
set -e
if [ "$1" = "remove" ]; then
    for unit in $(systemctl list-units --all --plain --no-legend 'fcitx5-vnkey-server@*' 2>/dev/null | awk '{print $1}'); do
        systemctl disable --now "$unit" 2>/dev/null || true
    done
fi
command -v py3clean >/dev/null 2>&1 && py3clean -p fcitx5-vnkey 2>/dev/null || true
find /usr/share/fcitx5-vnkey -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
exit 0
